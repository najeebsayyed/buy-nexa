# BuyNexa Environment Configuration
APP_NAME=BuyNexa
APP_ENV=development # Set to "production" in live deployment
API_V1_PREFIX=/api/v1
DEBUG=false

# Frontend Origin for CORS (e.g. http://localhost:5173 for dev, http://localhost:3000 for docker)
FRONTEND_ORIGIN=http://localhost:5173

# PostgreSQL Database Configuration
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=buynexa
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/buynexa

# OpenAI API (server-side only)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Channel3 API (server-side only)
CHANNEL3_API_KEY=
CHANNEL3_BASE_URL=https://api.trychannel3.com

# PayPal Orders v2 Sandbox (server-side only)
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com

# Public PayPal Client ID for browser PayPal JavaScript SDK (Vite public env)
VITE_PAYPAL_CLIENT_ID=

# Anonymous Session Cookie Configuration
SESSION_COOKIE_NAME=buynexa_session
SESSION_COOKIE_SECURE=false # Set to true in production over HTTPS
SESSION_MAX_AGE_DAYS=30
