# BuyNexa Environment Configuration
APP_NAME=BuyNexa
APP_ENV=development
API_V1_PREFIX=/api/v1

# Frontend URL for CORS (in development)
FRONTEND_ORIGIN=http://localhost:5173

# PostgreSQL connection string with asyncpg driver
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/buynexa

# OpenAI configuration (used by FastAPI backend only)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Channel3 API configuration (used by FastAPI backend only)
CHANNEL3_API_KEY=

# PayPal Orders v2 Sandbox configuration (used by FastAPI backend only)
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com

# Session cookie configuration
SESSION_COOKIE_NAME=buynexa_session
SESSION_COOKIE_SECURE=false
SESSION_MAX_AGE_DAYS=30
